rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isValidUser(data) {
      return data.email is string &&
        data.displayName is string &&
        data.createdAt is timestamp && data.createdAt <= request.time &&
        data.lastActive is timestamp && data.lastActive <= request.time;
    }

    function isValidProject(data, userId) {
      return data.userId == userId &&
        data.name is string && data.name.size() >= 1 && data.name.size() <= 100 &&
        data.aspectRatio is string &&
        data.resolution is string &&
        data.fps is int && data.fps > 0 &&
        data.clipsCount is int && data.clipsCount >= 0 &&
        (data.durationSeconds is int || data.durationSeconds is float || data.durationSeconds is number) && data.durationSeconds >= 0 &&
        data.thumbnailUri is string &&
        data.createdAt is timestamp && data.createdAt <= request.time &&
        data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    match /users/{userId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId) && isValidUser(request.resource.data);
      allow update: if isOwner(userId) && isValidUser(request.resource.data);
      allow delete: if isOwner(userId);

      match /projects/{projectId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId) && isValidProject(request.resource.data, userId);
        allow update: if isOwner(userId) && isValidProject(request.resource.data, userId);
        allow delete: if isOwner(userId);
      }
    }
  }
}
